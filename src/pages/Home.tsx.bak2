// ─── Discovery Dashboard (Desktop) ───
const DiscoveryDashboard = React.memo(function DiscoveryDashboard({
  liveItems,
  liveAuctions,
  onLiveItemClick,
  onRequireAuth,
  isPwa,
}: {
  liveItems: LiveItem[]
  liveAuctions: AuctionShow[]
  onLiveItemClick: (item: LiveItem) => void
  onRequireAuth: (intent?: string) => boolean
  isPwa: boolean
}) {
  const { users: newUsers, loading: loadingNewUsers } = useNewUsers(12)
  const { posts: trendingPosts, loading: loadingTrending } = useTrendingPosts(10)
  const { families, loading: loadingFamilies } = useTopFamilies(10)
  const { events, loading: loadingEvents } = useUpcomingEvents(10)
  const { streams: gamingStreams, loading: loadingGaming } = useGamingStreams(10)
  const { announcements, loading: loadingAnnouncements } = useCityAnnouncements(8)
  const { isMobileWidth } = useIsMobile()

  const featuredBroadcasters = useMemo(
    () => liveItems.filter(i => i.isFeatured || i.viewerCount > 0).slice(0, 10),
    [liveItems]
  )

  const auctionCards = useMemo(
    () => liveAuctions.slice(0, 8).map(a => ({
      id: a.id,
      title: a.title || 'Untitled Auction',
      thumbnail_url: a.thumbnail_url,
      current_bid: 0,
      ends_at: a.live_started_at,
    })),
    [liveAuctions]
  )

  const showSponsored = !isPwa && !isMobileWidth

  return (
    <div className="space-y-5">
      {/* Section 1: Featured Broadcasters */}
      {featuredBroadcasters.length > 0 && (
        <div className={`${glass} rounded-2xl p-4`}>
          <DiscoverySection
            title="Featured Broadcasters"
            icon={<Tv className="w-4 h-4 text-red-400" />}
            headerExtra={
              <button className="text-[10px] font-bold text-cyan-300 hover:text-cyan-200 transition-colors">
                View All →
              </button>
            }
          >
            {featuredBroadcasters.map((item) => (
              <BroadcasterCard key={item.id} stream={{
                id: item.id,
                title: item.title,
                streamerName: item.streamerName,
                streamerAvatar: item.streamerAvatar,
                viewerCount: item.viewerCount,
                isFeatured: item.isFeatured,
                category: item.category,
              }} />
            ))}
          </DiscoverySection>
        </div>
      )}

      {/* Section 2: New Citizens */}
      {newUsers.length > 0 && !loadingNewUsers && (
        <div className={`${glass} rounded-2xl p-4`}>
          <DiscoverySection
            title="New Citizens"
            icon={<UserPlus className="w-4 h-4 text-green-400" />}
          >
            {newUsers.map((user) => (
              <NewUserCard key={user.id} user={user} />
            ))}
          </DiscoverySection>
        </div>
      )}

      {/* Sponsored card between sections (desktop only) */}
      {showSponsored && (
        <div className="flex justify-center">
          <SponsoredCard
            title="Your Brand Here"
            subtitle="Reach thousands of Trolls"
            ctaText="Advertise"
            icon={<Megaphone className="w-8 h-8 text-purple-400" />}
            gradient="from-purple-500/15 to-cyan-500/5 border-purple-500/15"
          />
        </div>
      )}

      {/* Section 3: Troll Wall */}
      <div className={`${glass} rounded-2xl p-4`}>
        <DiscoverySection
          title="Troll Wall"
          icon={<MessageCircle className="w-4 h-4 text-pink-400" />}
          headerExtra={
            <span className="rounded-full border border-cyan-300/25 bg-cyan-300/10 px-2.5 py-0.5 text-[10px] font-black text-cyan-100">
              ∞ LIVE FEED
            </span>
          }
        >
          <div className="snap-start flex-shrink-0 w-full">
            <TrollWallFeed onRequireAuth={onRequireAuth} feedClassName="w-full max-h-[400px] overflow-y-auto" />
          </div>
        </DiscoverySection>
      </div>

      {/* Section 4: Troll City Announcements */}
      {announcements.length > 0 && !loadingAnnouncements && (
        <div className={`${glass} rounded-2xl p-4`}>
          <DiscoverySection
            title="Troll City Announcements"
            icon={<Shield className="w-4 h-4 text-cyan-400" />}
          >
            {announcements.map((a) => (
              <AnnouncementCard key={a.id} announcement={a} />
            ))}
          </DiscoverySection>
        </div>
      )}

      {/* Section 5: HyTroGaming */}
      {gamingStreams.length > 0 && !loadingGaming && (
        <div className={`${glass} rounded-2xl p-4`}>
          <DiscoverySection
            title="HyTroGaming"
            icon={<Gamepad2 className="w-4 h-4 text-green-400" />}
            headerExtra={
              <Link
                to="/hytrogaming"
                className="text-[10px] font-bold text-cyan-300 hover:text-cyan-200 transition-colors"
              >
                View All →
              </Link>
            }
          >
            {gamingStreams.map((stream) => (
              <GamingStreamCard key={stream.id} stream={stream} />
            ))}
          </DiscoverySection>
        </div>
      )}

      {/* Sponsored card between sections */}
      {showSponsored && (
        <div className="flex justify-center">
          <SponsoredCard
            title="Troll City Store"
            subtitle="Exclusive items & themes"
            ctaText="Shop Now"
            icon={<Sparkles className="w-8 h-8 text-amber-400" />}
            gradient="from-amber-500/15 to-orange-500/5 border-amber-500/15"
          />
        </div>
      )}

      {/* Section 6: Trending */}
      {trendingPosts.length > 0 && !loadingTrending && (
        <div className={`${glass} rounded-2xl p-4`}>
          <DiscoverySection
            title="Trending (24h)"
            icon={<Flame className="w-4 h-4 text-orange-400" />}
          >
            {trendingPosts.map((post) => (
              <TrendingCard key={post.id} post={post} />
            ))}
          </DiscoverySection>
        </div>
      )}

      {/* Section 7: Family Spotlight */}
      {families.length > 0 && !loadingFamilies && (
        <div className={`${glass} rounded-2xl p-4`}>
          <DiscoverySection
            title="Family Spotlight"
            icon={<Crown className="w-4 h-4 text-amber-400" />}
            headerExtra={
              <Link
                to="/families"
                className="text-[10px] font-bold text-cyan-300 hover:text-cyan-200 transition-colors"
              >
                View All →
              </Link>
            }
          >
            {families.map((family) => (
              <FamilyCard key={family.id} family={family} />
            ))}
          </DiscoverySection>
        </div>
      )}

      {/* Section 8: Trending Auctions */}
      {auctionCards.length > 0 && (
        <div className={`${glass} rounded-2xl p-4`}>
          <DiscoverySection
            title="Trending Auctions"
            icon={<Gavel className="w-4 h-4 text-amber-400" />}
            headerExtra={
              <Link
                to="/auctions"
                className="text-[10px] font-bold text-cyan-300 hover:text-cyan-200 transition-colors"
              >
                View All →
              </Link>
            }
          >
            {auctionCards.map((auction) => (
              <AuctionCard key={auction.id} auction={auction} />
            ))}
          </DiscoverySection>
        </div>
      )}

      {/* Section 9: Upcoming Events */}
      {events.length > 0 && !loadingEvents && (
        <div className={`${glass} rounded-2xl p-4`}>
          <DiscoverySection
            title="Upcoming Events"
            icon={<Calendar className="w-4 h-4 text-violet-400" />}
            headerExtra={
              <Link
                to="/events"
                className="text-[10px] font-bold text-cyan-300 hover:text-cyan-200 transition-colors"
              >
                View All →
              </Link>
            }
          >
            {events.map((event) => (
              <EventCard key={event.id} event={event} />
            ))}
          </DiscoverySection>
        </div>
      )}

      {/* Final sponsored card */}
      {showSponsored && (
        <div className="flex justify-center pb-4">
          <SponsoredCard
            title="Go Live on Troll City"
            subtitle="Start streaming today"
            ctaText="Get Started"
            icon={<Radio className="w-8 h-8 text-red-400" />}
            gradient="from-red-500/15 to-pink-500/5 border-red-500/15"
          />
        </div>
      )}
    </div>
  )
})

// ─── Mobile Discovery Layout ───
const MobileDiscoveryLayout = React.memo(function MobileDiscoveryLayout({
  liveItems,
  liveAuctions,
  onLiveItemClick,
  onRequireAuth,
}: {
  liveItems: LiveItem[]
  liveAuctions: AuctionShow[]
  onLiveItemClick: (item: LiveItem) => void
  onRequireAuth: (intent?: string) => boolean
}) {
  const { users: newUsers, loading: loadingNewUsers } = useNewUsers(8)
  const { posts: trendingPosts, loading: loadingTrending } = useTrendingPosts(8)
  const { families, loading: loadingFamilies } = useTopFamilies(8)
  const { events, loading: loadingEvents } = useUpcomingEvents(8)
  const { streams: gamingStreams, loading: loadingGaming } = useGamingStreams(8)
  const { announcements, loading: loadingAnnouncements } = useCityAnnouncements(6)

  const featuredBroadcasters = useMemo(
    () => liveItems.filter(i => i.isFeatured || i.viewerCount > 0).slice(0, 8),
    [liveItems]
  )

  const auctionCards = useMemo(
    () => liveAuctions.slice(0, 6).map(a => ({
      id: a.id,
      title: a.title || 'Untitled Auction',
      thumbnail_url: a.thumbnail_url,
      current_bid: 0,
      ends_at: a.live_started_at,
    })),
    [liveAuctions]
  )

  return (
    <div className="space-y-4 px-3">
      {/* Section 1: Featured Broadcasters */}
      {featuredBroadcasters.length > 0 && (
        <DiscoverySection title="🔥 Featured Broadcasters" showArrows={false}>
          {featuredBroadcasters.map((item) => (
            <BroadcasterCard key={item.id} stream={{
              id: item.id,
              title: item.title,
              streamerName: item.streamerName,
              streamerAvatar: item.streamerAvatar,
              viewerCount: item.viewerCount,
              isFeatured: item.isFeatured,
              category: item.category,
            }} />
          ))}
        </DiscoverySection>
      )}

      {/* Sponsored */}
      <div className="flex justify-center">
        <SponsoredCard
          title="Your Brand Here"
          ctaText="Advertise"
          icon={<Megaphone className="w-6 h-6 text-purple-400" />}
          gradient="from-purple-500/15 to-cyan-500/5 border-purple-500/15"
        />
      </div>

      {/* Section 2: New Citizens */}
      {newUsers.length > 0 && !loadingNewUsers && (
        <DiscoverySection title="👋 New Citizens" showArrows={false}>
          {newUsers.map((user) => (
            <NewUserCard key={user.id} user={user} />
          ))}
        </DiscoverySection>
      )}

      {/* Section 3: Troll Wall */}
      <DiscoverySection title="📢 Troll Wall" showArrows={false}>
        <div className="snap-start flex-shrink-0 w-full">
          <TrollWallFeed onRequireAuth={onRequireAuth} feedClassName="w-full max-h-[350px] overflow-y-auto" />
        </div>
      </DiscoverySection>

      {/* Sponsored */}
      <div className="flex justify-center">
        <SponsoredCard
          title="Troll City Store"
          ctaText="Shop Now"
          icon={<Sparkles className="w-6 h-6 text-amber-400" />}
          gradient="from-amber-500/15 to-orange-500/5 border-amber-500/15"
        />
      </div>

      {/* Section 4: HyTroGaming */}
      {gamingStreams.length > 0 && !loadingGaming && (
        <DiscoverySection title="🎮 HyTroGaming" showArrows={false}>
          {gamingStreams.map((stream) => (
            <GamingStreamCard key={stream.id} stream={stream} />
          ))}
        </DiscoverySection>
      )}

      {/* Section 5: Troll City News */}
      {announcements.length > 0 && !loadingAnnouncements && (
        <DiscoverySection title="🏛 Troll City Updates" showArrows={false}>
          {announcements.map((a) => (
            <AnnouncementCard key={a.id} announcement={a} />
          ))}
        </DiscoverySection>
      )}

      {/* Sponsored */}
      <div className="flex justify-center">
        <SponsoredCard
          title="Go Live Today"
          ctaText="Start Streaming"
          icon={<Radio className="w-6 h-6 text-red-400" />}
          gradient="from-red-500/15 to-pink-500/5 border-red-500/15"
        />
      </div>

      {/* Section 6: Trending */}
      {trendingPosts.length > 0 && !loadingTrending && (
        <DiscoverySection title="📈 Trending" showArrows={false}>
          {trendingPosts.map((post) => (
            <TrendingCard key={post.id} post={post} />
          ))}
        </DiscoverySection>
      )}

      {/* Section 7: Families */}
      {families.length > 0 && !loadingFamilies && (
        <DiscoverySection title="👑 Family Spotlight" showArrows={false}>
          {families.map((family) => (
            <FamilyCard key={family.id} family={family} />
          ))}
        </DiscoverySection>
      )}

      {/* Section 8: Auctions */}
      {auctionCards.length > 0 && (
        <DiscoverySection title="🔨 Trending Auctions" showArrows={false}>
          {auctionCards.map((auction) => (
            <AuctionCard key={auction.id} auction={auction} />
          ))}
        </DiscoverySection>
      )}

      {/* Section 9: Upcoming Events */}
      {events.length > 0 && !loadingEvents && (
        <DiscoverySection title="📅 Upcoming Events" showArrows={false}>
          {events.map((event) => (
            <EventCard key={event.id} event={event} />
          ))}
        </DiscoverySection>
      )}
    </div>
  )
})

export default function Home() {
  const navigate = useNavigate()
  const user = useAuthStore((state) => state.user)
  const isLoading = useAuthStore((state) => state.isLoading)
  const isPwa = useIsPwa()
  const { isMobileWidth } = useIsMobile()

  useSEO({
    title: 'Troll City | Social Streaming Platform - Livestream, Create, Connect',
    description: 'Troll City (Mai Troll City) is a social streaming platform for creators, streamers, gamers, and online communities. Watch live streams, go live, join creator battles, spin the Troll Wheel, and connect with a global community.',
    keywords: [
      'Troll City', 'Mai Troll City', 'social streaming platform', 'live streaming',
      'go live', 'content creator', 'stream games online', 'watch live streams',
      'creator economy', 'livestream', 'gaming community', 'online entertainment',
      'social platform', 'streaming app', 'live broadcast', 'creator battles',
      'online games', 'virtual community', 'trending streams', 'FYP'
    ],
    structuredData: [websiteSchema(), organizationSchema()]
  })

  const [activeTab, setActiveTab] = useState<TabType>('wall')
  const [showLiveGrid, setShowLiveGrid] = useState<boolean | null>(null)
  const [kickedReason, setKickedReason] = useState<string | null>(null)

  useEffect(() => {
    const params = new URLSearchParams(window.location.search)
    const kicked = params.get('kicked')
    if (kicked) {
      setKickedReason(kicked)
      const newUrl = window.location.pathname
      window.history.replaceState({}, '', newUrl)
    }
  }, [])

  const { liveItems, liveAuctions, totalViewers, loadingLive } = useLiveContent()
  const [supportGoalReminder, setSupportGoalReminder] = useState<any>(null)
  const [reminderLoading, setReminderLoading] = useState(false)

  const {
    reminder: supportReminder,
    loading: reminderLoadingState,
    refetch: fetchSupportReminder,
  } = useSupportGoalReminder()
  usePresidentSystem()

  const battleItems = useMemo(() => liveItems.filter((item) => item.isBattle), [liveItems])

  const auctionItems = useMemo(() => liveAuctions.map((auction) => ({
    id: auction.id,
    title: auction.title || 'Untitled Auction',
    type: 'auction' as const,
    viewerCount: 0,
    streamerName: 'Auction',
    streamerAvatar: null,
    isFeatured: false,
    isBattle: false,
  })), [liveAuctions])

  const allLiveItems = useMemo(() => [...liveItems, ...auctionItems], [liveItems, auctionItems])

  useEffect(() => {
    window.scrollTo(0, 0)
  }, [])

  useEffect(() => {
    if (user?.id) {
      // Hook fetches automatically
    }
  }, [user?.id, fetchSupportReminder])

  useEffect(() => {
    setSupportGoalReminder(supportReminder)
    setReminderLoading(reminderLoadingState)
  }, [supportReminder, reminderLoadingState])

  useEffect(() => {
    if (isPwa && ['laws-fees', 'leagues', 'president', 'academy'].includes(activeTab)) {
      setActiveTab('wall')
    }
  }, [isPwa, activeTab])

  const requireAuth = useCallback(
    (intent?: string) => {
      if (user) return true
      toast.info(`Sign in to ${intent || 'continue'}.`)
      navigate('/auth')
      return false
    },
    [navigate, user],
  )

  const handleLiveItemClick = useCallback((item: LiveItem) => {
    if (item.type === 'auction') {
      navigate(`/auctions/${item.id}`)
    } else if (item.category === 'gaming') {
      navigate(`/gaming/watch/${item.id}`)
    } else {
      navigate(`/watch/${item.id}`)
    }
  }, [navigate])

  const goLive = useCallback(() => {
    if (!requireAuth('go live')) return
    navigate('/broadcast/setup')
  }, [requireAuth, navigate])

  const isMobile = isMobileWidth

  return (
    <div className="relative min-h-full w-full overflow-hidden text-white">
      <OriginalBackground />

      {isLoading && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-[#050715]/85 backdrop-blur-md">
          <div className="text-center">
            <div className="mx-auto mb-4 h-16 w-16 animate-spin rounded-full border-4 border-purple-500/30 border-t-cyan-300" />
            <p className="text-sm font-bold text-slate-300">Loading Troll City...</p>
          </div>
        </div>
      )}

      <Suspense fallback={null}>
        <TCNNPopupWidget onRequireAuth={requireAuth} />
      </Suspense>

      <Suspense fallback={null}>
        <PWAInstallPrompt />
      </Suspense>

      <main className="relative z-10 mx-auto flex w-full max-w-[1520px] flex-col gap-3 px-3 pb-8 pt-3 md:px-5">
        {kickedReason && (
          <div className="flex items-center justify-between gap-3 rounded-xl border border-red-500/30 bg-red-950/60 px-4 py-3 backdrop-blur-sm">
            <div className="flex items-center gap-3">
              <div className="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-500/20">
                <X className="h-4 w-4 text-red-400" />
              </div>
              <div>
                <p className="text-sm font-bold text-red-300">You've been kicked</p>
                <p className="text-xs text-red-400/80">{kickedReason}</p>
              </div>
            </div>
            <button
              onClick={() => setKickedReason(null)}
              className="shrink-0 rounded-lg p-1 text-red-400/60 transition hover:bg-red-500/10 hover:text-red-300"
            >
              <X size={16} />
            </button>
          </div>
        )}

        {/* Browse Categories — SEO internal linking hub (hidden in PWA) */}
        {!isPwa && (
          <div className="grid grid-cols-3 gap-2 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-6">
            {[
              { slug: 'gaming', label: 'Gaming', subtitle: 'HytroGaming', icon: Gamepad2, href: '/hytrogaming' },
              { slug: 'just-chatting', label: 'Chat', subtitle: 'UtroMail', icon: MessageCircle, href: '/utromail' },
              { slug: 'education', label: 'Learn', subtitle: 'Academy', icon: BookOpen, href: '/academy' },
              { slug: 'entertainment', label: 'Fun', subtitle: 'Troll Wheel', icon: Sparkles, href: '/wheel' },
              { slug: 'politics', label: 'Politics', subtitle: 'Government', icon: Vote, href: '/government' },
              { slug: 'news', label: 'News', subtitle: 'TCNN', icon: Radio, href: '/tcnn' },
            ].map((cat) => {
              const Icon = cat.icon
              const to = cat.href || `/categories/${cat.slug}`
              return (
                <Link
                  key={cat.slug}
                  to={to}
                  className="group relative overflow-hidden rounded-2xl px-3 py-3 text-left transition-all duration-300 border border-white/10 bg-white/[0.04] hover:border-purple-400/30 hover:bg-purple-600/10"
                >
                  <div className="relative z-10 flex flex-col gap-1.5">
                    <Icon className="h-4 w-4 text-slate-300 group-hover:text-white" />
                    <div>
                      <p className="text-xs font-black leading-tight text-slate-200">
                        {cat.label}
                      </p>
                      <p className="text-[10px] leading-tight text-slate-400">
                        {cat.subtitle}
                      </p>
                    </div>
                  </div>
                </Link>
              )
            })}
          </div>
        )}

        <HomeTabs
          activeTab={activeTab}
          setActiveTab={setActiveTab}
          liveCount={allLiveItems.length}
          battleCount={battleItems.length}
          isPwa={isPwa}
        />

        <Suspense fallback={null}>
          <div className="hidden lg:block">
            <PromoSlot placement="home_horizontal_banner" variant="horizontal" />
          </div>
        </Suspense>

        {/* ─── WALL TAB: Discovery Dashboard ─── */}
        {activeTab === 'wall' && (
          isMobile ? (
            <MobileDiscoveryLayout
              liveItems={allLiveItems}
              liveAuctions={liveAuctions}
              onLiveItemClick={handleLiveItemClick}
              onRequireAuth={requireAuth}
            />
          ) : (
            <section className="grid grid-cols-1 gap-3 lg:grid-cols-[1fr_280px] xl:grid-cols-[140px_minmax(0,1fr)_280px_140px]">
              <DesktopAdSidebar position="left" />
              <div className="min-w-0">
                <DiscoveryDashboard
                  liveItems={allLiveItems}
                  liveAuctions={liveAuctions}
                  onLiveItemClick={handleLiveItemClick}
                  onRequireAuth={requireAuth}
                  isPwa={isPwa}
                />
              </div>
              <div className="hidden space-y-3 lg:block">
                {liveAuctions.length > 0 && <LiveAuctionMiniWindow auction={liveAuctions[0]} onRequireAuth={requireAuth} />}
                <CityAnnouncementCard />
              </div>
              <DesktopAdSidebar position="right" />
            </section>
          )
        )}

        {activeTab === 'live' && (
          <LiveGrid
            liveItems={allLiveItems}
            loadingLive={loadingLive}
            totalViewers={totalViewers}
            showLiveGrid={showLiveGrid}
            setShowLiveGrid={setShowLiveGrid}
            onClickItem={handleLiveItemClick}
          />
        )}

        {activeTab === 'universe' && <BattleGrid items={battleItems} onClickItem={handleLiveItemClick} />}

        {activeTab === 'laws-fees' && (
          <section className={`${glass} rounded-2xl p-4`}>
            <Suspense fallback={<div className="flex justify-center py-12"><div className="h-8 w-8 animate-spin rounded-full border-2 border-cyan-300 border-t-transparent" /></div>}>
              <CityLawsFeesTab />
            </Suspense>
          </section>
        )}

        {activeTab === 'leagues' && (
          <section className={`${glass} rounded-2xl p-4`}>
            <Suspense fallback={<div className="flex justify-center py-12"><div className="h-8 w-8 animate-spin rounded-full border-2 border-purple-300 border-t-transparent" /></div>}>
              <LeaguesTab />
            </Suspense>
          </section>
        )}

        {activeTab === 'president' && (
          <section className={`${glass} rounded-2xl p-4`}>
            <Suspense fallback={<div className="flex justify-center py-12"><div className="h-8 w-8 animate-spin rounded-full border-2 border-amber-300 border-t-transparent" /></div>}>
              <PresidentCandidatesTab />
            </Suspense>
          </section>
        )}

        {activeTab === 'academy' && (
          <AcademyTab />
        )}
      </main>

      <JoinPoster />

      {supportGoalReminder && !reminderLoading && (
        <SupportGoalReminderModal
          isOpen={true}
          onClose={() => setSupportGoalReminder(null)}
          broadcaster={supportGoalReminder}
        />
      )}
    </div>
  )
}
