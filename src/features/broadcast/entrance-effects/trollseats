export type TrollSeatStatus =
  | 'empty'
  | 'pending_payment'
  | 'paid_pending_approval'
  | 'occupied'
  | 'removed'

export interface TrollSeat {
  id: string
  stream_id: string
  seat_index: number
  status: TrollSeatStatus
  user_id: string | null
  broadcaster_id: string
  seat_price: number
  paid_amount: number
  paid_at: string | null
  approved_at: string | null
  left_at: string | null
  refunded_amount: number
  refund_reason: string | null
  created_at: string
  updated_at: string
}

export interface TrollSeatUserProfile {
  id: string
  username?: string | null
  display_name?: string | null
  avatar_url?: string | null
  profile_image_url?: string | null
  photo_url?: string | null
  role?: string | null
}

export interface TrollSeatTrackBundle {
  videoTrack?: any
  audioTrack?: any
  isMicMuted?: boolean
  isCameraOff?: boolean
  participantIdentity?: string
}

export interface TrollSeatGoldenRingMap {
  [userId: string]: boolean
}

export interface TrollSeatCoinReceivedMap {
  [userId: string]: number
}

export interface TrollSeatsOverlayProps {
  streamId: string
  broadcasterId: string
  currentUserId?: string | null
  isBroadcaster?: boolean
  trollSeats: TrollSeat[]
  profilesByUserId?: Record<string, TrollSeatUserProfile>
  tracksByUserId?: Record<string, TrollSeatTrackBundle>
  goldenRingByUserId?: TrollSeatGoldenRingMap
  onOpenUserStats?: (userId: string) => void
  onRequestSeat?: () => void
  className?: string
}