# ==========================================
# Troll City — Environment Variables Template
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==========================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# LiveKit Server (client-side - VITE_ prefixed for Vite)
VITE_LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
VITE_LIVEKIT_API_KEY=your-livekit-api-key

# Agora
VITE_AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
VITE_AGORA_REGION=na
VITE_AGORA_PLAYER_URL=https://your-domain.com/agora-player

# LiveKit Server (server-side - non-prefixed for backend)
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Mux Core
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret

# Supabase Service Key — SERVER SIDE ONLY, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Backend API
VITE_BROADCAST_API_URL=http://localhost:3002/api
BACKEND_URL=http://localhost:3002

# Supabase Edge Functions
VITE_EDGE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1

# PayPal
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENV=sandbox

# VAPID Keys for Web Push
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Cloudflare R2 (Broadcast Replays Storage)
CF_R2_ACCOUNT_ID=your-r2-account-id
CF_R2_ACCESS_KEY_ID=your-r2-access-key-id
CF_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CF_R2_BUCKET_NAME=broadcast-replays
CF_R2_PUBLIC_URL=https://your-r2-public-url.r2.dev
